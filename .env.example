# Copy this file's idea, not the file itself, into GitHub repo secrets.
# These are NOT read automatically by the site — GitHub Actions injects them
# into js/config.js at deploy time. See README.md.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here

# NEVER put SUPABASE_SERVICE_ROLE_KEY anywhere in this repo, in GitHub
# Actions, or in the browser. It bypasses Row Level Security entirely.
